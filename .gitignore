# Python 编译缓存
*.pyc
__pycache__/
*.zip

#ignore data cleanup trash
cleanup_trash/
saved_data/gap_fill_diagnostics/
backup_signal_replay/

# Ignore realtime/cache data
saved_data/akshare_realtime_cache/
saved_data/realtime_context/

# BEGIN saved_data pipeline ignore
# 只忽略每个 pipeline 文件夹下的 00 到 10 中间产物目录
# 不再使用 saved_data/*/*，避免误伤 saved_data 下其他目录
saved_data/*/00*/
saved_data/*/01*/
saved_data/*/02*/
saved_data/*/03*/
saved_data/*/04*/
saved_data/*/05*/
saved_data/*/06*/
saved_data/*/07*/
saved_data/*/08*/
saved_data/*/09*/
saved_data/*/10*/

# 明确保留摘要目录和根目录摘要文件
!saved_data/*/99_summary/
!saved_data/*/99_summary/**
!saved_data/*/pipeline_summary.json
!saved_data/*/run.log
# END saved_data pipeline ignore
+def normalize_initial_positions(initial_positions: object | None) -> dict[str, dict[str, object]]:
+    """Normalize an externally supplied account state for live/sliced execution.
+
+    Historical callers omit this argument and retain the original empty-account
+    behavior. Live callers should validate broker fields before invoking the
+    engine; this helper remains permissive enough for replay and testing.
+    """
+    if initial_positions is None:
+        return {}
+    if isinstance(initial_positions, pd.DataFrame):
+        frame = initial_positions.copy()
+    elif isinstance(initial_positions, dict):
+        if all(isinstance(v, dict) for v in initial_positions.values()):
+            rows = []
+            for key, value in initial_positions.items():
+                row = dict(value)
+                row.setdefault("symbol", key)
+                rows.append(row)
+            frame = pd.DataFrame(rows)
+        else:
+            frame = pd.DataFrame(initial_positions)
+    else:
+        frame = pd.DataFrame(initial_positions)
+    if frame.empty:
+        return {}
+    if "symbol" not in frame.columns:
+        if "code" in frame.columns:
+            frame["symbol"] = frame["code"]
+        else:
+            raise ValueError("initial_positions requires symbol/code")
+    if "shares" not in frame.columns:
+        raise ValueError("initial_positions requires shares")
+    frame["symbol"] = frame["symbol"].map(normalize_symbol)
+    frame["shares"] = pd.to_numeric(frame["shares"], errors="coerce")
+    out: dict[str, dict[str, object]] = {}
+    for _, row in frame.iterrows():
+        sym = str(row.get("symbol", ""))
+        shares = float(row.get("shares", np.nan))
+        if not sym or not np.isfinite(shares) or shares <= 0:
+            continue
+        raw_buy_date = row.get("buy_date", row.get("entry_date", None))
+        buy_date = pd.to_datetime(raw_buy_date, errors="coerce")
+        if pd.isna(buy_date):
+            buy_date = pd.Timestamp("1900-01-01")
+        else:
+            buy_date = pd.Timestamp(buy_date).normalize()
+        avg_entry_price = pd.to_numeric(pd.Series([row.get("avg_entry_price", row.get("cost_price", np.nan))]), errors="coerce").iloc[0]
+        avg_entry_price = float(avg_entry_price) if np.isfinite(avg_entry_price) else np.nan
+        cost_notional = pd.to_numeric(pd.Series([row.get("cost_basis_notional", np.nan)]), errors="coerce").iloc[0]
+        if not np.isfinite(cost_notional):
+            cost_notional = shares * avg_entry_price if np.isfinite(avg_entry_price) else 0.0
+        cost_fee = pd.to_numeric(pd.Series([row.get("cost_basis_fee", 0.0)]), errors="coerce").iloc[0]
+        cost_fee = float(cost_fee) if np.isfinite(cost_fee) else 0.0
+        out[sym] = {
+            "shares": shares,
+            "buy_date": buy_date,
+            "avg_entry_price": avg_entry_price,
+            "entry_rank": row.get("entry_rank", np.nan),
+            "entry_score": row.get("entry_score", np.nan),
+            "cost_basis_notional": float(cost_notional),
+            "cost_basis_fee": cost_fee,
+        }
+    return out
+

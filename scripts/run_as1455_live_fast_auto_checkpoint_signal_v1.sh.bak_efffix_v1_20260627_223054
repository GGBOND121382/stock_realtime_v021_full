#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."

MODE="${1:-auto}"

# First run the existing fast data/feature pipeline if available, then checkpoint signal.
case "$MODE" in
  auto|pre|post|status)
    if [[ -x scripts/run_as1455_live_fast_auto_v1.sh ]]; then
      echo "[INFO] running fast data/feature pipeline: $MODE"
      TRADE_DATE="${TRADE_DATE:-today}" bash scripts/run_as1455_live_fast_auto_v1.sh "$MODE"
    else
      echo "[ERROR] scripts/run_as1455_live_fast_auto_v1.sh not found. Install fastpath/fast_auto first, or run checkpoint signal only after features exist." >&2
      exit 2
    fi
    if [[ "$MODE" == "status" || "$MODE" == "pre" ]]; then
      exit 0
    fi
    ;;
  signal)
    ;;
  *)
    echo "usage: $0 [auto|pre|post|signal|status]" >&2
    exit 2
    ;;
esac

echo "[INFO] running checkpoint signal layer"
TRADE_DATE="${TRADE_DATE:-today}" bash scripts/run_as1455_live_checkpoint_signal_v1.sh

#!/usr/bin/env bash
# AS1455 live data + feature pipeline controller.
#
# This script does NOT run NN inference and does NOT submit orders.
# It orchestrates four data/feature stages:
#   1) history   : update historical raw 5m/raw daily/AS1455 daily caches to T-1
#   2) prepare   : fetch T-day preclose, detect adjustment events, build live qfq history tail
#   3) collect   : collect T-day as-of-14:55 raw snapshot row
#   4) features  : build T-day live model feature matrix
#
# Usage examples:
#   bash scripts/run_as1455_live_data_feature_pipeline.sh check
#   bash scripts/run_as1455_live_data_feature_pipeline.sh history
#   bash scripts/run_as1455_live_data_feature_pipeline.sh prepare
#   bash scripts/run_as1455_live_data_feature_pipeline.sh collect
#   bash scripts/run_as1455_live_data_feature_pipeline.sh features
#   bash scripts/run_as1455_live_data_feature_pipeline.sh all
#   bash scripts/run_as1455_live_data_feature_pipeline.sh auto
#
# Common overrides:
#   TRADE_DATE=20260624 bash scripts/run_as1455_live_data_feature_pipeline.sh all
#   MAX_SYMBOLS=20 bash scripts/run_as1455_live_data_feature_pipeline.sh all
#   COLLECT_MODE=collect-once bash scripts/run_as1455_live_data_feature_pipeline.sh collect
#   DRY_RUN=1 bash scripts/run_as1455_live_data_feature_pipeline.sh history

set -Eeuo pipefail

MODE="${1:-help}"
if [[ $# -gt 0 ]]; then
  shift
fi

PYTHON="${PYTHON:-python3}"
TRADE_DATE="${TRADE_DATE:-today}"
HISTORY_END_DATE="${HISTORY_END_DATE:-auto}"
HISTORY_START_DATE="${HISTORY_START_DATE:-2020-01-01}"
HISTORY_TAIL_DAYS="${HISTORY_TAIL_DAYS:-252}"
EVENT_THRESHOLD_PCT="${EVENT_THRESHOLD_PCT:-0.10}"
MIN_VALID_RATE="${MIN_VALID_RATE:-0.98}"
MIN_FEATURE_ROWS="${MIN_FEATURE_ROWS:-980}"

UNIVERSE="${UNIVERSE:-saved_data/ashare_ml4t/ch12_as1455/as1455_model_universe_from_h5.csv}"
OUT_ROOT="${OUT_ROOT:-saved_data/ashare_ml4t/live_as1455}"
RAW_5M_CACHE_DIR="${RAW_5M_CACHE_DIR:-saved_data/ashare_ml4t/ch12_as1455/baostock_5m_cache}"
RAW_DAILY_CACHE_DIR="${RAW_DAILY_CACHE_DIR:-saved_data/ashare_ml4t/ch12_as1455/baostock_raw_daily_cache}"
AS1455_DAILY_CACHE_DIR="${AS1455_DAILY_CACHE_DIR:-saved_data/ashare_ml4t/ch12_as1455/as1455_daily_cache}"
FEATURE_COLUMNS="${FEATURE_COLUMNS:-}"
SECTOR_REFERENCE="${SECTOR_REFERENCE:-saved_data/ashare_ml4t/ch12_as1455/model_data_as1455.h5}"
ALLOW_SECTOR_FALLBACK="${ALLOW_SECTOR_FALLBACK:-0}"
VALIDATE_LIVE_FEATURES="${VALIDATE_LIVE_FEATURES:-1}"

# Auto mode schedule, interpreted in TIMEZONE.
# PREPARE_TIME should be after real-time preclose is reliable.
TIMEZONE="${TIMEZONE:-Asia/Shanghai}"
PREPARE_TIME="${PREPARE_TIME:-09:35:00}"
COLLECT_START_TIME="${COLLECT_START_TIME:-14:50:00}"

BATCH_SIZE="${BATCH_SIZE:-250}"
TIMEOUT_SECONDS="${TIMEOUT_SECONDS:-8}"
BATCH_SLEEP_SECONDS="${BATCH_SLEEP_SECONDS:-0.2}"
SLEEP_SECONDS="${SLEEP_SECONDS:-0.05}"

COLLECT_MODE="${COLLECT_MODE:-collect-loop}"
INTERVAL_SECONDS="${INTERVAL_SECONDS:-30}"
UNTIL="${UNTIL:-14:55:05}"
CUTOFF_TIME="${CUTOFF_TIME:-14:55:00}"
RUN_ID="${RUN_ID:-$(date +%Y%m%d_%H%M%S)}"

MAX_SYMBOLS="${MAX_SYMBOLS:-}"
DRY_RUN="${DRY_RUN:-0}"
SKIP_PRECLOSE_FETCH="${SKIP_PRECLOSE_FETCH:-0}"
NO_BAOSTOCK_CALENDAR="${NO_BAOSTOCK_CALENDAR:-0}"
SKIP_AS1455_AGGREGATE="${SKIP_AS1455_AGGREGATE:-0}"

LOG_ROOT="${LOG_ROOT:-logs}"
mkdir -p "${LOG_ROOT}"

SCRIPT_HISTORY="${SCRIPT_HISTORY:-pipelines/as1455_update_history_to_prevday_fast_v3.py}"
SCRIPT_PREPARE="pipelines/as1455_live_prepare.py"
SCRIPT_COLLECT="data_collection/collect_as1455_live_quotes_as1455.py"
SCRIPT_FEATURES="features/build_as1455_live_features.py"
SCRIPT_COMMON="features/as1455_live_common.py"

usage() {
  cat <<'EOF'
Usage:
  bash scripts/run_as1455_live_data_feature_pipeline.sh <mode>

Modes:
  check       Verify required scripts and py_compile them.
  history     Update historical BaoStock raw 5m/raw daily/AS1455 daily caches to T-1.
  prepare     Fetch today's preclose, rebuild live adjustment state, and build history qfq tail.
  collect     Collect today's AS1455 raw snapshot row around 14:55.
  features    Build today's live model features.
  all         Run history -> prepare -> collect -> features immediately.
  pre         Run history -> prepare immediately. Best used after 09:35 and before 14:50.
  post        Run collect -> features immediately. Best used around 14:50.
  auto        Start-and-forget mode: update history, wait for prepare/collect windows, then build features.
  status      Print current live-dir reports if present.

Environment overrides:
  PYTHON=python3
  TRADE_DATE=today | YYYYMMDD | YYYY-MM-DD
  HISTORY_END_DATE=auto | YYYYMMDD | YYYY-MM-DD  # auto is resolved from history report or local caches
  UNIVERSE=saved_data/ashare_ml4t/ch12_as1455/as1455_model_universe_from_h5.csv
  OUT_ROOT=saved_data/ashare_ml4t/live_as1455
  MAX_SYMBOLS=20
  DRY_RUN=1
  COLLECT_MODE=collect-loop | collect-once
  UNTIL=14:55:05
  CUTOFF_TIME=14:55:00
  FEATURE_COLUMNS=saved_data/ashare_ml4t/ch17_as1455_deploy/feature_columns.json
  TIMEZONE=Asia/Shanghai
  PREPARE_TIME=09:35:00
  COLLECT_START_TIME=14:50:00
EOF
}

live_date() {
  "${PYTHON}" - <<PY
from datetime import datetime
s = "${TRADE_DATE}"
if s.lower() == "today":
    print(datetime.now().strftime("%Y%m%d"))
else:
    s = s.replace("-", "")
    datetime.strptime(s, "%Y%m%d")
    print(s)
PY
}

LIVE_DATE="$(live_date)"
LIVE_DIR="${OUT_ROOT}/${LIVE_DATE}"

log_path() {
  local name="$1"
  echo "${LOG_ROOT}/as1455_live_${name}_${LIVE_DATE}_$(date +%H%M%S).log"
}

info() {
  echo "[INFO] $*"
}

fail() {
  echo "[ERROR] $*" >&2
  exit 1
}

seconds_now() {
  TZ="${TIMEZONE}" "${PYTHON}" - <<'PY'
from datetime import datetime
now = datetime.now()
print(now.hour * 3600 + now.minute * 60 + now.second)
PY
}

time_to_seconds() {
  local t="$1"
  "${PYTHON}" - "$t" <<'PY'
import sys
s = sys.argv[1]
parts = s.split(':')
if len(parts) == 2:
    h, m = map(int, parts)
    sec = 0
elif len(parts) == 3:
    h, m, sec = map(int, parts)
else:
    raise SystemExit(f"bad time: {s}")
print(h * 3600 + m * 60 + sec)
PY
}

wait_until_time() {
  local target="$1"
  local target_sec now_sec sleep_sec
  target_sec="$(time_to_seconds "${target}")"
  now_sec="$(seconds_now)"
  if (( now_sec >= target_sec )); then
    info "current time already >= ${target}; no wait"
    return 0
  fi
  sleep_sec=$(( target_sec - now_sec ))
  info "waiting ${sleep_sec}s until ${target} (${TIMEZONE})"
  sleep "${sleep_sec}"
}

report_key_is_true() {
  local path="$1"
  local key="$2"
  [[ -f "${path}" ]] || return 1
  "${PYTHON}" - "$path" "$key" <<'PY' >/dev/null 2>&1
import json, sys
path, key = sys.argv[1], sys.argv[2]
try:
    obj = json.load(open(path, encoding="utf-8"))
    val = obj
    for part in key.split('.'):
        val = val[part]
except Exception:
    raise SystemExit(1)
raise SystemExit(0 if val is True else 1)
PY
}

prepare_already_passed() {
  report_key_is_true "${LIVE_DIR}/05_prepare_report.json" "prepare_passed"
}

collection_already_passed() {
  report_key_is_true "${LIVE_DIR}/08_collection_report.json" "collection_passed"
}

features_already_passed() {
  report_key_is_true "${LIVE_DIR}/12_feature_build_report.json" "feature_passed"
}


require_file() {
  local p="$1"
  [[ -f "${p}" ]] || fail "missing file: ${p}"
}

require_script_files() {
  require_file "${SCRIPT_COMMON}"
  require_file "${SCRIPT_HISTORY}"
  require_file "${SCRIPT_PREPARE}"
  require_file "${SCRIPT_COLLECT}"
  require_file "${SCRIPT_FEATURES}"
  require_file "${UNIVERSE}"
}

py_compile_all() {
  require_script_files
  "${PYTHON}" -m py_compile \
    "${SCRIPT_COMMON}" \
    "${SCRIPT_HISTORY}" \
    "${SCRIPT_PREPARE}" \
    "${SCRIPT_COLLECT}" \
    "${SCRIPT_FEATURES}"
}

json_bool_check() {
  local path="$1"
  local key="$2"
  require_file "${path}"
  "${PYTHON}" - "$path" "$key" <<'PY'
import json, sys
path, key = sys.argv[1], sys.argv[2]
obj = json.load(open(path, encoding="utf-8"))
val = obj
for part in key.split('.'):
    val = val[part]
if val is not True:
    raise SystemExit(f"{path}: expected {key}=true, got {val!r}")
print(f"[OK] {path}: {key}=true")
PY
}

get_history_end_from_report() {
  local p="${LIVE_DIR}/00_history_update_report.json"
  require_file "${p}"
  "${PYTHON}" - "$p" <<'PY'
import json, sys
obj = json.load(open(sys.argv[1], encoding="utf-8"))
print(obj["history_end_date"])
PY
}

print_context() {
  cat <<EOF
[CONFIG]
  MODE=${MODE}
  PYTHON=${PYTHON}
  TRADE_DATE=${TRADE_DATE}
  LIVE_DATE=${LIVE_DATE}
  LIVE_DIR=${LIVE_DIR}
  HISTORY_END_DATE=${HISTORY_END_DATE}
  UNIVERSE=${UNIVERSE}
  MAX_SYMBOLS=${MAX_SYMBOLS:-<none>}
  OUT_ROOT=${OUT_ROOT}
  RAW_5M_CACHE_DIR=${RAW_5M_CACHE_DIR}
  RAW_DAILY_CACHE_DIR=${RAW_DAILY_CACHE_DIR}
  AS1455_DAILY_CACHE_DIR=${AS1455_DAILY_CACHE_DIR}
  FEATURE_COLUMNS=${FEATURE_COLUMNS:-<none>}
  SECTOR_REFERENCE=${SECTOR_REFERENCE}
  ALLOW_SECTOR_FALLBACK=${ALLOW_SECTOR_FALLBACK}
  VALIDATE_LIVE_FEATURES=${VALIDATE_LIVE_FEATURES}
  TIMEZONE=${TIMEZONE}
  PREPARE_TIME=${PREPARE_TIME}
  COLLECT_START_TIME=${COLLECT_START_TIME}
  UNTIL=${UNTIL}
  CUTOFF_TIME=${CUTOFF_TIME}
EOF
}

max_symbols_args=()
if [[ -n "${MAX_SYMBOLS}" ]]; then
  max_symbols_args=(--max-symbols "${MAX_SYMBOLS}")
fi

run_history() {
  info "running history update"
  mkdir -p "${LIVE_DIR}"
  local args=(
    "${SCRIPT_HISTORY}"
    --trade-date "${TRADE_DATE}"
    --history-end-date "${HISTORY_END_DATE}"
    --history-start-date "${HISTORY_START_DATE}"
    --universe "${UNIVERSE}"
    --raw-5m-cache-dir "${RAW_5M_CACHE_DIR}"
    --raw-daily-cache-dir "${RAW_DAILY_CACHE_DIR}"
    --as1455-daily-cache-dir "${AS1455_DAILY_CACHE_DIR}"
    --out-root "${OUT_ROOT}"
    --sleep-seconds "${SLEEP_SECONDS}"
    "${max_symbols_args[@]}"
  )
  [[ "${DRY_RUN}" == "1" ]] && args+=(--dry-run)
  [[ "${NO_BAOSTOCK_CALENDAR}" == "1" ]] && args+=(--no-baostock-calendar)
  [[ "${SKIP_AS1455_AGGREGATE}" == "1" ]] && args+=(--skip-as1455-aggregate)

  local log; log="$(log_path history)"
  "${PYTHON}" "${args[@]}" 2>&1 | tee "${log}"

  if [[ "${DRY_RUN}" != "1" ]]; then
    local errors
    errors=$("${PYTHON}" - <<PY
import json
p = "${LIVE_DIR}/00_history_update_report.json"
obj = json.load(open(p, encoding="utf-8"))
print(obj.get("errors", -1))
PY
)
    [[ "${errors}" == "0" ]] || fail "history update has errors=${errors}; see ${LIVE_DIR}/00_history_update_report.json"
  fi
}

run_prepare() {
  info "running live prepare"
  mkdir -p "${LIVE_DIR}"
  local hist_end="${HISTORY_END_DATE}"
  if [[ "${hist_end}" == "auto" || "${hist_end}" == "prev" || "${hist_end}" == "prev_trade_date" ]]; then
    if [[ -f "${LIVE_DIR}/00_history_update_report.json" ]]; then
      hist_end="$(get_history_end_from_report)"
      info "prepare history_end_date=${hist_end} resolved from history report"
    else
      hist_end="auto"
      info "prepare history_end_date=auto; ${SCRIPT_PREPARE} will infer it from local caches"
    fi
  else
    info "prepare history_end_date=${hist_end}"
  fi

  local args=(
    "${SCRIPT_PREPARE}"
    --trade-date "${TRADE_DATE}"
    --history-end-date "${hist_end}"
    --universe "${UNIVERSE}"
    --raw-daily-cache-dir "${RAW_DAILY_CACHE_DIR}"
    --as1455-daily-cache-dir "${AS1455_DAILY_CACHE_DIR}"
    --out-root "${OUT_ROOT}"
    --history-tail-days "${HISTORY_TAIL_DAYS}"
    --event-threshold-pct "${EVENT_THRESHOLD_PCT}"
    --batch-size "${BATCH_SIZE}"
    --timeout-seconds "${TIMEOUT_SECONDS}"
    --batch-sleep-seconds "${BATCH_SLEEP_SECONDS}"
    "${max_symbols_args[@]}"
  )
  [[ "${SKIP_PRECLOSE_FETCH}" == "1" ]] && args+=(--skip-preclose-fetch)

  local log; log="$(log_path prepare)"
  "${PYTHON}" "${args[@]}" 2>&1 | tee "${log}"
  json_bool_check "${LIVE_DIR}/05_prepare_report.json" "prepare_passed"
}

run_collect() {
  info "running live quote collection: ${COLLECT_MODE}"
  mkdir -p "${LIVE_DIR}"
  local args=(
    "${SCRIPT_COLLECT}"
    "${COLLECT_MODE}"
    --trade-date "${TRADE_DATE}"
    --universe "${UNIVERSE}"
    --out-root "${OUT_ROOT}"
    --batch-size "${BATCH_SIZE}"
    --timeout-seconds "${TIMEOUT_SECONDS}"
    --batch-sleep-seconds "${BATCH_SLEEP_SECONDS}"
    --cutoff-time "${CUTOFF_TIME}"
    --min-valid-rate "${MIN_VALID_RATE}"
    --run-id "${RUN_ID}"
    "${max_symbols_args[@]}"
  )
  if [[ "${COLLECT_MODE}" == "collect-loop" ]]; then
    args+=(--interval-seconds "${INTERVAL_SECONDS}" --until "${UNTIL}")
  fi
  if [[ "${COLLECT_MODE}" == "collect-once" ]]; then
    args+=(--finalize)
  fi

  local log; log="$(log_path collect)"
  "${PYTHON}" "${args[@]}" 2>&1 | tee "${log}"
  json_bool_check "${LIVE_DIR}/08_collection_report.json" "collection_passed"
}

run_features() {
  info "building live features"
  mkdir -p "${LIVE_DIR}"
  local args=(
    "${SCRIPT_FEATURES}"
    --trade-date "${TRADE_DATE}"
    --out-root "${OUT_ROOT}"
    --min-feature-rows "${MIN_FEATURE_ROWS}"
    --sector-reference "${SECTOR_REFERENCE}"
  )
  if [[ "${ALLOW_SECTOR_FALLBACK}" == "1" ]]; then
    args+=(--allow-sector-fallback)
  fi

  if [[ -n "${FEATURE_COLUMNS}" ]]; then
    require_file "${FEATURE_COLUMNS}"
    args+=(--training-feature-columns "${FEATURE_COLUMNS}")
  fi

  local log; log="$(log_path features)"
  "${PYTHON}" "${args[@]}" 2>&1 | tee "${log}"
  json_bool_check "${LIVE_DIR}/12_feature_build_report.json" "feature_passed"
  if [[ "${VALIDATE_LIVE_FEATURES}" == "1" ]]; then
    "${PYTHON}" tools/validate_as1455_live_model_features_v2.py \
      --live-dir "${LIVE_DIR}" \
      --trade-date "${TRADE_DATE}" \
      --sector-reference "${SECTOR_REFERENCE}" \
      --min-feature-rows "${MIN_FEATURE_ROWS}"
  fi
}


run_auto() {
  print_context
  py_compile_all

  local now_sec prepare_sec collect_sec until_sec
  prepare_sec="$(time_to_seconds "${PREPARE_TIME}")"
  collect_sec="$(time_to_seconds "${COLLECT_START_TIME}")"
  until_sec="$(time_to_seconds "${UNTIL}")"
  now_sec="$(seconds_now)"

  info "auto mode current seconds=${now_sec}; prepare=${PREPARE_TIME}; collect_start=${COLLECT_START_TIME}; until=${UNTIL}; timezone=${TIMEZONE}"

  if (( now_sec < collect_sec )); then
    # Safe window: do history now, but do not fetch preclose before PREPARE_TIME.
    run_history

    now_sec="$(seconds_now)"
    if (( now_sec < prepare_sec )); then
      wait_until_time "${PREPARE_TIME}"
    fi
    run_prepare

    now_sec="$(seconds_now)"
    if (( now_sec < collect_sec )); then
      wait_until_time "${COLLECT_START_TIME}"
    fi

    run_collect
    run_features
    return 0
  fi

  # After collect start: do not risk a late history/prepare unless prepare already passed.
  if (( now_sec >= collect_sec && now_sec <= until_sec )); then
    info "already in collect window"
    if ! prepare_already_passed; then
      fail "prepare report is missing or failed after collect window started. Run 'pre' earlier, or start auto before ${COLLECT_START_TIME}."
    fi
    run_collect
    run_features
    return 0
  fi

  # After collection window: only build features if collection already exists.
  if (( now_sec > until_sec )); then
    info "current time is after collection window"
    if collection_already_passed; then
      if features_already_passed; then
        info "features already passed; nothing to do"
      else
        run_features
      fi
      return 0
    fi
    fail "too late for collection and no passed collection report found: ${LIVE_DIR}/08_collection_report.json"
  fi
}

run_status() {
  print_context
  echo
  for p in \
    "${LIVE_DIR}/00_history_update_report.json" \
    "${LIVE_DIR}/05_prepare_report.json" \
    "${LIVE_DIR}/08_collection_report.json" \
    "${LIVE_DIR}/12_feature_build_report.json"; do
    if [[ -f "${p}" ]]; then
      echo "===== ${p} ====="
      cat "${p}"
      echo
    else
      echo "[MISSING] ${p}"
    fi
  done
}

case "${MODE}" in
  help|-h|--help)
    usage
    ;;
  check)
    print_context
    py_compile_all
    info "check passed"
    ;;
  history)
    print_context
    py_compile_all
    run_history
    ;;
  prepare)
    print_context
    py_compile_all
    run_prepare
    ;;
  collect)
    print_context
    py_compile_all
    run_collect
    ;;
  features)
    print_context
    py_compile_all
    run_features
    ;;
  pre)
    print_context
    py_compile_all
    run_history
    run_prepare
    ;;
  post)
    print_context
    py_compile_all
    run_collect
    run_features
    ;;
  all)
    print_context
    py_compile_all
    run_history
    run_prepare
    run_collect
    run_features
    ;;
  auto)
    run_auto
    ;;
  status)
    run_status
    ;;
  *)
    usage
    fail "unknown mode: ${MODE}"
    ;;
esac
